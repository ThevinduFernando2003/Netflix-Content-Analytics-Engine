# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42
PORT=8000
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Paths (override only if needed) ---
# PROJECT_ROOT=
# MLFLOW_TRACKING_URI=./mlruns

# --- Optional catalogue enrichment (off by default; CI must not enable) ---
ENRICHMENT_ENABLED=false
TMDB_API_KEY=
OMDB_API_KEY=

# --- Optional LLM polish of insight prose (off by default; CI must not enable) ---
INSIGHT_LLM_POLISH=false
OPENAI_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Dashboard ---
STREAMLIT_SERVER_PORT=8501
